    "measure.atticFloorInsulation.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the attic isn't used, insulating its floor is a smart, affordable choice."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt de zolder niet gebruikt? Dan is de zoldervloer isoleren slim en betaalbaar."
          }
        }
      }
    },
    "measure.balancedVentilation.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat-recovery ventilation"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventilatie met warmteterugwinning"
          }
        }
      }
    },
    "measure.balancedVentilation.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fresh air in, stale air out — and the heat is passed over to the incoming air."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frisse lucht erin, vieze lucht eruit — en de warmte gaat over naar de verse lucht."
          }
        }
      }
    },
    "measure.cavityWallInsulation.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cavity wall insulation"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouwmuurisolatie"
          }
        }
      }
    },
    "measure.cavityWallInsulation.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filling the gap between the two brick walls: one of the best value measures."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ruimte tussen de twee muren vullen: een van de voordeligste maatregelen."
          }
        }
      }
    },
    "measure.demandVentilation.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart ventilation"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slimme ventilatie"
          }
        }
      }
    },
    "measure.demandVentilation.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CO₂ sensors ventilate exactly as much as needed. A well-sealed home needs fresh air."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "CO₂-sensoren ventileren precies genoeg. Een goed dicht huis heeft frisse lucht nodig."
          }
        }
      }
    },
    "measure.draughtProofing.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draught-proofing"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierdichting"
          }
        }
      }
    },
    "measure.draughtProofing.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seal gaps around doors and windows. Cheap, quick, and you feel it right away."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicht de kieren rond deuren en ramen. Goedkoop, snel en je merkt het meteen."
          }
        }
      }
    },
    "measure.floorInsulation.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floor insulation"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vloerisolatie"
          }
        }
      }
    },
    "measure.floorInsulation.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm feet! Insulation under the floor stops the cold rising from the crawl space."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warme voeten! Isolatie onder de vloer houdt de kou uit de kruipruimte tegen."
          }
        }
      }
    },
    "measure.heatPump.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat pump"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmtepomp"
          }
        }
      }
    },
    "measure.heatPump.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heats the whole home without gas. Works best in a well-insulated house — that's why you insulate first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwarmt het hele huis zonder gas. Werkt het best in een goed geïsoleerd huis — daarom eerst isoleren."
          }
        }
      }
    },
    "measure.hrGlazing.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HR++ glazing"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HR++-glas"
          }
        }
      }
    },
    "measure.hrGlazing.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double glazing with a special coating loses far less heat than old single glass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbel glas met een speciale coating verliest veel minder warmte dan oud enkel glas."
          }
        }
      }
    },
